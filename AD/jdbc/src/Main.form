<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/"
      version="1"
      bind-to-class="Main">

  <grid id="panelGlowny"
        binding="panelGlowny"
        layout-manager="BorderLayout"
        hgap="10"
        vgap="10">

    <margin top="10" left="10" bottom="10" right="10"/>

    <constraints>
      <xy x="20" y="20" width="700" height="500"/>
    </constraints>

    <properties>
      <preferredSize width="700" height="500"/>
    </properties>

    <border type="none"/>

    <children>

      <!-- FORMULARZ -->
      <grid id="formularz"
            layout-manager="GridLayoutManager"
            row-count="4"
            column-count="2"
            same-size-horizontally="false"
            same-size-vertically="false">

        <margin top="10" left="10" bottom="10" right="10"/>

        <constraints border-constraint="North"/>

        <properties>
          <border type="titled" title="Dane pracownika"/>
        </properties>

        <border type="none"/>

        <children>

          <component id="labelImie"
                     class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="0"
                    row-span="1" col-span="1"
                    anchor="8" fill="0"
                    hsize-policy="0" vsize-policy="0"/>
            </constraints>
            <properties>
              <text value="Imię:"/>
            </properties>
          </component>

          <component id="txtImie"
                     class="javax.swing.JTextField"
                     binding="txtImie">
            <constraints>
              <grid row="0" column="1"
                    row-span="1" col-span="1"
                    anchor="0" fill="1"
                    hsize-policy="6" vsize-policy="0"/>
            </constraints>
            <properties/>
          </component>

          <component id="labelNazwisko"
                     class="javax.swing.JLabel">
            <constraints>
              <grid row="1" column="0"
                    row-span="1" col-span="1"
                    anchor="8" fill="0"
                    hsize-policy="0" vsize-policy="0"/>
            </constraints>
            <properties>
              <text value="Nazwisko:"/>
            </properties>
          </component>

          <component id="txtNazwisko"
                     class="javax.swing.JTextField"
                     binding="txtNazwisko">
            <constraints>
              <grid row="1" column="1"
                    row-span="1" col-span="1"
                    anchor="0" fill="1"
                    hsize-policy="6" vsize-policy="0"/>
            </constraints>
            <properties/>
          </component>

          <component id="labelStanowisko"
                     class="javax.swing.JLabel">
            <constraints>
              <grid row="2" column="0"
                    row-span="1" col-span="1"
                    anchor="8" fill="0"
                    hsize-policy="0" vsize-policy="0"/>
            </constraints>
            <properties>
              <text value="Stanowisko:"/>
            </properties>
          </component>

          <component id="txtStanowisko"
                     class="javax.swing.JTextField"
                     binding="txtStanowisko">
            <constraints>
              <grid row="2" column="1"
                    row-span="1" col-span="1"
                    anchor="0" fill="1"
                    hsize-policy="6" vsize-policy="0"/>
            </constraints>
            <properties/>
          </component>

          <component id="btnDodaj"
                     class="javax.swing.JButton"
                     binding="btnDodaj">
            <constraints>
              <grid row="3" column="1"
                    row-span="1" col-span="1"
                    anchor="0" fill="1"
                    hsize-policy="3" vsize-policy="0"/>
            </constraints>
            <properties>
              <text value="Dodaj Pracownika"/>
            </properties>
          </component>

        </children>
      </grid>

      <!-- TABELA -->
      <scrollpane id="scrollPane">

        <constraints border-constraint="Center"/>

        <properties/>

        <border type="none"/>

        <children>

          <component id="tabelaPracownikow"
                     class="javax.swing.JTable"
                     binding="tabelaPracownikow">
            <constraints/>
            <properties>
              <autoCreateRowSorter value="true"/>
              <rowHeight value="25"/>
            </properties>
          </component>

        </children>
      </scrollpane>

    </children>
  </grid>
</form>
